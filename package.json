{
  "name": "@jsse/geo-ts",
  "version": "0.0.3",
  "private": true,
  "description": "geo-json-schemas by way of typebox",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "buildog": "pnpm run -r build",
    "change": "changeset",
    "dev": "vitest watch",
    "fmt": "prettier --write . --cache",
    "fmtc": "prettier --check .",
    "fmtl": "prettier --list-different .",
    "lint": "eslint .",
    "publish": "pnpm publish -r",
    "release": "pnpm run -r build && changeset publish",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile && pnpm fmt",
    "ci:publish": "pnpm publish -r",
    "test": "vitest run"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@jsse/eslint-config": "^0.9.20",
    "@jsse/tsconfig": "^0.6.1",
    "dprint": "^0.55.2",
    "eslint": "^10.8.1",
    "eslint-plugin-perfectionist": "~5.10.1",
    "prettier": "^3.9.6",
    "syncpack": "^15.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^18.0.0 || >=20.0.0"
  }
}
