{
  "name": "@jsse/geo",
  "version": "0.0.37",
  "description": "geo typescript",
  "keywords": [],
  "license": "MIT",
  "author": "jessekrubin",
  "files": [
    "!**/*.test-data.*",
    "!**/*.test.*",
    "!**/*.tsbuildinfo",
    "CHANGELOG.md",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js",
      "require": "./dist/json.cjs"
    },
    "./lib/*": {
      "types": "./dist/esm/*",
      "import": "./dist/esm/*",
      "require": "./dist/cjs/*"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build-fast": "tsdown src/index.ts --format cjs,esm",
    "build": "pnpm run build:tsdown && pnpm run build:tsc",
    "build:tsdown": "tsdown --format cjs,esm --dts",
    "build:tsc": "tsc -b tsconfig.build.json && tsx scripts/post-build.mts",
    "test": "vitest run",
    "cov": "vitest run --coverage",
    "dev": "vitest watch --coverage",
    "lint": "eslint .",
    "fmt": "prettier --write . --ignore-path ../../.prettierignore",
    "nodetest": "node --import tsx --test ./src/*test.ts",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@jsse/geojson": "workspace:*",
    "@jsse/geotypes": "workspace:*",
    "@turf/meta": "catalog:"
  },
  "devDependencies": {
    "@jsse/eslint-config": "catalog:",
    "@jsse/geotypes": "workspace:*",
    "@jsse/tsconfig": "catalog:",
    "@turf/helpers": "catalog:",
    "@turf/random": "catalog:",
    "@turf/turf": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "benchmark": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
