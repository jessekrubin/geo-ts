{
  "name": "@jsse/geotypes",
  "version": "0.0.37",
  "description": "geo types",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./geojson": {
      "types": "./dist/esm/geojson.d.ts",
      "import": "./dist/esm/geojson.js",
      "require": "./dist/cjs/geojson.js"
    },
    "./lib/*": {
      "types": "./dist/esm/*",
      "import": "./dist/esm/*",
      "require": "./dist/cjs/*"
    },
    "./dist/*": {
      "types": "./dist/esm/*",
      "import": "./dist/esm/*"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build-fast": "tsdown src/geojson.ts --format cjs,esm",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tsd.json",
    "build": "pnpm run typecheck && pnpm run build:tsdown && pnpm run build:tsc",
    "build:tsc": "tsc -p tsconfig.json",
    "build:indexes": "tsx ./build.mts",
    "build:tsdown": "tsdown --format cjs,esm --dts",
    "test": "vitest run",
    "dev": "vitest watch --coverage",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@jsse/eslint-config": "^0.9.21",
    "@jsse/tsconfig": "^0.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zx": "^8.8.5"
  }
}
